# Copy to .env (gitignored) for local runs. Dagster auto-loads .env from the
# working directory, so these values are picked up by `uv run dagster dev`.
#
# Point this at your test bucket so a local run never writes to the shared
# bucket — and so you never have to edit (and risk committing) the tracked
# .dlt/config.toml. Unset, the pipeline falls back to the bucket_url in
# .dlt/config.toml.
GCS_BUCKET_URL=gs://my-test-bucket

# Where FROST lives. Unset, the loader falls back to the service_root_url in
# .dlt/config.toml, which points at the local `docker compose` FROST. A localhost
# URL is called unauthenticated; any other host gets a Google ID token, which
# requires service account credentials (see GCP_SERVICE_ACCOUNT_KEY_B64 below).
FROST_SERVICE_ROOT_URL=http://localhost:8081/FROST-Server

# Base64-encoded service account key, for exercising the Dagster+ code path
# locally (see `./deploy/30_dagster_gcp_auth.sh --emit-key for key generation)`.
# Leave unset to use your own `gcloud auth application-default login` credentials,
# but note those cannot mint the ID tokens a remote FROST_SERVICE_ROOT_URL needs.
# GCP_SERVICE_ACCOUNT_KEY_B64=
