# Copy to .env (gitignored) for local runs. Dagster auto-loads .env from the
# working directory, so these values are picked up by `uv run dagster dev`.
#
# GCS_BUCKET_URL is REQUIRED for every run — there is no default. Locally, point
# it at your test bucket so a run never writes to the shared bucket and you never
# have to edit (and risk committing) the tracked .dlt/config.toml. A run with it
# unset fails fast with a clear error rather than writing anywhere.
GCS_BUCKET_URL=gs://my-test-bucket
